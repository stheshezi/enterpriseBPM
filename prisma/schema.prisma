generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVAL
  FINANCE_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TaskStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum AuditAction {
  REQUEST_CREATED
  REQUEST_SUBMITTED
  TASK_ASSIGNED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  STATUS_CHANGED
  USER_LOGIN
  USER_CREATED
  ROLE_UPDATED
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  EMAIL
  SELECT
  RADIO
  CHECKBOX
  TEXTAREA
}

model Tenant {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  roles          Role[]
  travelRequests TravelRequest[]
  workflowTasks  WorkflowTask[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  forms          Form[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  roles          UserRole[]
  travelRequests TravelRequest[]
  assignedTasks  WorkflowTask[]
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model Role {
  id       String @id @default(uuid())
  name     String @unique
  tenantId String

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  users  UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model TravelRequest {
  id            String        @id @default(uuid())
  requestNumber String        @unique
  requesterId   String
  tenantId      String
  department    String
  destination   String
  travelType    String
  startDate     DateTime
  endDate       DateTime
  purpose       String
  estimatedCost Float
  costCenter    String
  status        RequestStatus @default(DRAFT)
  currentStep   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  requester User           @relation(fields: [requesterId], references: [id])
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  tasks     WorkflowTask[]
  auditLogs AuditLog[]
}

model WorkflowTask {
  id          String     @id @default(uuid())
  requestId   String
  assigneeId  String?
  tenantId    String
  stepName    String
  status      TaskStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  request   TravelRequest @relation(fields: [requestId], references: [id])
  assignee  User?         @relation(fields: [assigneeId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]
}

model AuditLog {
  id              String      @id @default(uuid())
  tenantId        String
  actorUserId     String?
  travelRequestId String?
  workflowTaskId  String?
  entityType      String
  entityId        String?
  action          AuditAction
  oldValue        String?
  newValue        String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  actorUser     User?          @relation(fields: [actorUserId], references: [id])
  travelRequest TravelRequest? @relation(fields: [travelRequestId], references: [id])
  workflowTask  WorkflowTask?  @relation(fields: [workflowTaskId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  type      String
  payload   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

model Form {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  fields FormField[]
}

model FormField {
  id         String    @id @default(uuid())
  formId     String
  label      String
  name       String
  type       FieldType
  required   Boolean   @default(false)
  order      Int
  validation String?
  options    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  form Form @relation(fields: [formId], references: [id])
}
